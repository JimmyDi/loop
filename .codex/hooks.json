{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-worktree-hook.mjs\"",
            "statusMessage": "Checking Git checkout isolation"
          }
        ]
      }
    ]
  }
}
