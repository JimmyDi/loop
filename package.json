{
  "name": "@loop-harness/loop",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A local-first coding assistant with CLI, SDK and Web interfaces.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "loop": "./dist/bin.js"
  },
  "scripts": {
    "dev": "node --watch --watch-preserve-output --conditions=loop-source --import tsx bin.ts web --dev",
    "coding-agent": "node --conditions=loop-source --import tsx bin.ts",
    "build": "pnpm -r build && tsdown && node scripts/copy-web.mjs && pnpm check:distribution",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && pnpm check:architecture",
    "check:architecture": "vitest run scripts/architecture.test.ts packages/web-ui/src/architecture.test.ts",
    "check:distribution": "node --import tsx scripts/check-distribution.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepack": "pnpm build",
    "verify:package": "node --import tsx scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@hono/node-server": "^2.0.0",
    "which": "^6.0.0"
  },
  "devDependencies": {
    "@loop/agent": "workspace:*",
    "@loop/coding-agent": "workspace:*",
    "@loop/web-ui": "workspace:*",
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.22.0",
    "tsdown": "^0.22.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "fast-glob": "^3.3.3",
    "@types/which": "^3.0.0",
    "expect": "^30.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  }
}
