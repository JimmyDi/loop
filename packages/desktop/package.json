{
  "name": "@loop/desktop",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "dev": "node --import tsx scripts/dev.ts",
    "bundle": "pnpm build && tauri build --config .tools/tauri-build.json",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json",
    "bundle:release": "node --import tsx scripts/bundle-release.ts"
  },
  "dependencies": {
    "@loop/web-ui": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "tsx": "^4.22.0",
    "tsdown": "^0.22.0",
    "vite": "^8.0.0"
  }
}
